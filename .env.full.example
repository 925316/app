# ============================================================================
# Laravel Full Environment Configuration Example
# ============================================================================
# This file contains all available environment variable options for this Laravel application.
# Copy this file to .env and configure according to your environment.
# For shorter templates, see:
# - .env.development.example (local/dev)
# - .env.production.example (production)
# ============================================================================

# ----------------------------------------------------------------------------
# Application Basic Configuration
# ----------------------------------------------------------------------------
# Application name
APP_NAME=Laravel

# Application environment: local, development, staging, production, testing
APP_ENV=local

# Application key (run `php artisan key:generate` to create)
# Must be 32 characters long (AES-256)
APP_KEY=

# Debug mode: true/false
# IMPORTANT: Set to false in production!
APP_DEBUG=true

# Application URL
APP_URL=http://localhost:8000

# Asset URL (optional, defaults to APP_URL)
# ASSET_URL=http://localhost:8000

# Application timezone (optional, defaults to UTC)
# APP_TIMEZONE=Asia/Shanghai

# Application locale
APP_LOCALE=en

# Fallback locale
APP_FALLBACK_LOCALE=en

# Faker locale (for test data generation)
APP_FAKER_LOCALE=en_US

# ----------------------------------------------------------------------------
# Maintenance Mode Configuration
# ----------------------------------------------------------------------------
# Maintenance mode driver: file, database
APP_MAINTENANCE_DRIVER=file

# Storage location when using database driver
# APP_MAINTENANCE_STORE=database

# ----------------------------------------------------------------------------
# PHP CLI Server Configuration
# ----------------------------------------------------------------------------
# PHP built-in server workers (only for PHP CLI server mode)
# PHP_CLI_SERVER_WORKERS=4

# ----------------------------------------------------------------------------
# Security Configuration
# ----------------------------------------------------------------------------
# Bcrypt hash rounds (default 12, higher = more secure but slower)
BCRYPT_ROUNDS=12

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------
# Default log channel: stack, single, daily, slack, syslog, errorlog, stderr, null
LOG_CHANNEL=stack

# Log stack channels (comma-separated)
LOG_STACK=single

# Deprecation warnings log channel: null, single, daily, slack, syslog, errorlog, stderr
LOG_DEPRECATIONS_CHANNEL=null

# Log level: debug, info, notice, warning, error, critical, alert, emergency
LOG_LEVEL=debug

# Daily log retention days (only when LOG_CHANNEL=daily)
# LOG_DAILY_DAYS=14

# Slack Webhook URL (only when LOG_CHANNEL=slack)
# LOG_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# Slack username
# LOG_SLACK_USERNAME=Laravel Log

# Slack emoji
# LOG_SLACK_EMOJI=:boom:

# Syslog facility
# LOG_SYSLOG_FACILITY=LOG_USER

# Stderr formatter
# LOG_STDERR_FORMATTER=

# Papertrail URL
# PAPERTRAIL_URL=

# Papertrail port
# PAPERTRAIL_PORT=

# Deprecation trace
# LOG_DEPRECATIONS_TRACE=false

# ----------------------------------------------------------------------------
# Database Configuration - SQLite
# ----------------------------------------------------------------------------
# Database connection: sqlite, mysql, mariadb, pgsql, sqlsrv
DB_CONNECTION=sqlite

# Database URL (optional, can replace individual settings below)
# DB_URL=

# SQLite database file path (for sqlite connection)
DB_DATABASE=database/database.sqlite

# Enable foreign key constraints (sqlite connection)
# DB_FOREIGN_KEYS=true

# SQLite busy timeout
# DB_BUSY_TIMEOUT=

# SQLite journal mode
# DB_JOURNAL_MODE=

# SQLite synchronous mode
# DB_SYNCHRONOUS=

# SQLite transaction mode
# DB_TRANSACTION_MODE=DEFERRED

# ----------------------------------------------------------------------------
# Database Configuration - MySQL / MariaDB
# ----------------------------------------------------------------------------
# Database connection: mysql or mariadb
# DB_CONNECTION=mysql

# Database host
# DB_HOST=127.0.0.1

# Database port
# DB_PORT=3306

# Database name
# DB_DATABASE=laravel

# Database username
# DB_USERNAME=root

# Database password
# DB_PASSWORD=

# Unix Socket (optional)
# DB_SOCKET=

# Character set
# DB_CHARSET=utf8mb4

# Collation
# DB_COLLATION=utf8mb4_unicode_ci

# MySQL SSL CA certificate
# MYSQL_ATTR_SSL_CA=

# ----------------------------------------------------------------------------
# Database Configuration - PostgreSQL
# ----------------------------------------------------------------------------
# Database connection: pgsql
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# PostgreSQL SSL mode: prefer, require, disable, verify-ca, verify-full
# DB_SSLMODE=prefer

# DB_CHARSET=utf8

# ----------------------------------------------------------------------------
# Database Configuration - SQL Server
# ----------------------------------------------------------------------------
# Database connection: sqlsrv
# DB_CONNECTION=sqlsrv
# DB_HOST=localhost
# DB_PORT=1433
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Encrypted connection
# DB_ENCRYPT=yes

# Trust server certificate
# DB_TRUST_SERVER_CERTIFICATE=false

# DB_CHARSET=utf8

# ----------------------------------------------------------------------------
# Session Configuration
# ----------------------------------------------------------------------------
# Session driver: file, cookie, database, memcached, redis, dynamodb, array
SESSION_DRIVER=database

# Session lifetime (minutes)
SESSION_LIFETIME=120

# Session encryption
SESSION_ENCRYPT=false

# Session cookie path
SESSION_PATH=/

# Session cookie domain
SESSION_DOMAIN=null

# Session database connection (when using database driver)
# SESSION_CONNECTION=

# Session table name (when using database driver)
# SESSION_TABLE=sessions

# Session cache store (for dynamodb, memcached, redis drivers)
# SESSION_STORE=

# Expire session on browser close
# SESSION_EXPIRE_ON_CLOSE=false

# HTTPS-only cookies
# SESSION_SECURE_COOKIE=false

# HTTP-only cookies (prevents JavaScript access)
# SESSION_HTTP_ONLY=true

# Same-Site cookie policy: lax, strict, none, null
# SESSION_SAME_SITE=lax

# Partitioned cookies
# SESSION_PARTITIONED_COOKIE=false

# Session cookie name (defaults to {app_name}-session)
# SESSION_COOKIE=

# ----------------------------------------------------------------------------
# Broadcasting Configuration
# ----------------------------------------------------------------------------
# Broadcast connection: log, pusher, ably, redis
BROADCAST_CONNECTION=log

# Pusher configuration (when using Pusher)
# BROADCAST_DRIVER=pusher
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_HOST=
# PUSHER_PORT=443
# PUSHER_SCHEME=https
# PUSHER_APP_CLUSTER=mt1

# Ably configuration (when using Ably)
# ABLY_KEY=

# ----------------------------------------------------------------------------
# Filesystem Configuration
# ----------------------------------------------------------------------------
# Default filesystem disk: local, public, s3
FILESYSTEM_DISK=local

# S3 configuration
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# FTP configuration
# FTP_HOST=
# FTP_USERNAME=
# FTP_PASSWORD=

# SFTP configuration
# SFTP_HOST=
# SFTP_USERNAME=
# SFTP_PASSWORD=
# SFTP_PORT=22

# ----------------------------------------------------------------------------
# Queue Configuration
# ----------------------------------------------------------------------------
# Queue connection: sync, database, beanstalkd, sqs, redis, deferred, background, failover, null
QUEUE_CONNECTION=database

# Database queue configuration
# DB_QUEUE_CONNECTION=
# DB_QUEUE_TABLE=queued_jobs
# DB_QUEUE=default
# DB_QUEUE_RETRY_AFTER=90

# Beanstalkd queue configuration
# BEANSTALKD_QUEUE_HOST=localhost
# BEANSTALKD_QUEUE=default
# BEANSTALKD_QUEUE_RETRY_AFTER=90

# Redis queue configuration
# REDIS_QUEUE_CONNECTION=default
# REDIS_QUEUE=default
# REDIS_QUEUE_RETRY_AFTER=90

# SQS queue configuration
# SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account-id
# SQS_QUEUE=default
# SQS_SUFFIX=

# Failed queue driver: database-uuids, dynamodb, file, null
# QUEUE_FAILED_DRIVER=database-uuids

# ----------------------------------------------------------------------------
# Cache Configuration
# ----------------------------------------------------------------------------
# Cache store: array, database, file, memcached, redis, dynamodb, octane, failover, null
CACHE_STORE=database

# Cache prefix
# CACHE_PREFIX=

# Database cache configuration
# DB_CACHE_CONNECTION=
# DB_CACHE_TABLE=cache
# DB_CACHE_LOCK_CONNECTION=
# DB_CACHE_LOCK_TABLE=

# Memcached configuration
MEMCACHED_HOST=127.0.0.1
# MEMCACHED_PORT=11211
# MEMCACHED_PERSISTENT_ID=
# MEMCACHED_USERNAME=
# MEMCACHED_PASSWORD=

# DynamoDB configuration
# DYNAMODB_CACHE_TABLE=cache
# DYNAMODB_ENDPOINT=

# Redis cache connection
# REDIS_CACHE_CONNECTION=cache
# REDIS_CACHE_LOCK_CONNECTION=default
# REDIS_CACHE_DB=1

# ----------------------------------------------------------------------------
# Redis Configuration
# ----------------------------------------------------------------------------
# Redis client: phpredis, predis
REDIS_CLIENT=phpredis

# Redis host
REDIS_HOST=127.0.0.1

# Redis port
REDIS_PORT=6379

# Redis password
REDIS_PASSWORD=null

# Redis username (Redis 6.0+ ACL)
# REDIS_USERNAME=

# Redis URL (can replace individual settings)
# REDIS_URL=

# Redis default database
# REDIS_DB=0

# Redis cluster mode
# REDIS_CLUSTER=redis

# Redis prefix
# REDIS_PREFIX=

# Persistent connection
# REDIS_PERSISTENT=false

# Max retries
# REDIS_MAX_RETRIES=3

# Backoff algorithm
# REDIS_BACKOFF_ALGORITHM=decorrelated_jitter

# Backoff base (milliseconds)
# REDIS_BACKOFF_BASE=100

# Backoff cap (milliseconds)
# REDIS_BACKOFF_CAP=1000

# ----------------------------------------------------------------------------
# Mail Configuration
# ----------------------------------------------------------------------------
# Mail driver: smtp, sendmail, mailgun, ses, ses-v2, postmark, resend, log, array
MAIL_MAILER=smtp

# Mail URL (can replace individual settings below)
# MAIL_URL=

# SMTP protocol scheme: smtp, smtps
# MAIL_SCHEME=

# SMTP host
MAIL_HOST=sandbox.smtp.mailtrap.io

# SMTP port
MAIL_PORT=2525

# SMTP username
MAIL_USERNAME=null

# SMTP password
MAIL_PASSWORD=null

# SMTP timeout
# MAIL_TIMEOUT=

# EHLO domain
# MAIL_EHLO_DOMAIN=

# Sendmail path
# MAIL_SENDMAIL_PATH=/usr/sbin/sendmail -bs -i

# Log mail channel (when MAIL_MAILER=log)
# MAIL_LOG_CHANNEL=

# From address
MAIL_FROM_ADDRESS="hello@example.com"

# From name
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# Mail Services - Mailgun
# ----------------------------------------------------------------------------
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=
# MAILGUN_SECRET=
# MAILGUN_ENDPOINT=api.mailgun.net

# ----------------------------------------------------------------------------
# Mail Services - Postmark
# ----------------------------------------------------------------------------
# MAIL_MAILER=postmark
# POSTMARK_API_KEY=
# POSTMARK_MESSAGE_STREAM_ID=

# ----------------------------------------------------------------------------
# Mail Services - Resend
# ----------------------------------------------------------------------------
# MAIL_MAILER=resend
# RESEND_API_KEY=

# ----------------------------------------------------------------------------
# Mail Services - Amazon SES
# ----------------------------------------------------------------------------
# MAIL_MAILER=ses
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# ----------------------------------------------------------------------------
# AWS Services Configuration
# ----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# CloudFront / Custom S3 URL
# AWS_URL=

# Custom endpoint
# AWS_ENDPOINT=

# ----------------------------------------------------------------------------
# Third-Party Services Configuration
# ----------------------------------------------------------------------------
# Slack notifications
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=

# ----------------------------------------------------------------------------
# API Signing Configuration
# ----------------------------------------------------------------------------
# API signing private key path
# NOTE: Keep the private key out of git and restrict file permissions.
API_SIGNING_PRIVATE_KEY_PATH=storage/app/keys/api_private.pem

# API signing key ID
API_SIGNING_KEY_ID=main-2026-01

# API signing algorithm: RSA-2048-SHA256, RSA-4096-SHA256, ECDSA-SHA256
API_SIGNING_ALGORITHM=RSA-2048-SHA256

# ----------------------------------------------------------------------------
# Frontend Build Configuration (Vite)
# ----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# Additional Vite environment variables
# VITE_API_URL="${APP_URL}/api"
# VITE_WS_URL="${APP_URL}"

# ----------------------------------------------------------------------------
# Octane Configuration (High-Performance PHP Server)
# ----------------------------------------------------------------------------
# OCTANE_SERVER=swoole
# OCTANE_HOST=0.0.0.0
# OCTANE_PORT=8000
# OCTANE_WORKERS=4
# OCTANE_MAX_REQUESTS=500
# OCTANE_TASK_WORKERS=2

# ----------------------------------------------------------------------------
# Debug Tools Configuration
# ----------------------------------------------------------------------------
# Debugbar
# DEBUGBAR_ENABLED=true

# Telescope
# TELESCOPE_ENABLED=true

# Horizon
# HORIZON_ENABLED=true

# ----------------------------------------------------------------------------
# Monitoring & Tracing Configuration
# ----------------------------------------------------------------------------
# Sentry
# SENTRY_LARAVEL_DSN=
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=
# SENTRY_SAMPLE_RATE=1.0
# SENTRY_TRACES_SAMPLE_RATE=0.2

# Nightwatch
# NIGHTWATCH_ENABLED=true
# NIGHTWATCH_KEY=

# ----------------------------------------------------------------------------
# Testing Environment Configuration
# ----------------------------------------------------------------------------
# Test database connection
# DB_CONNECTION=sqlite_testing

# Test cache driver
# CACHE_STORE=array

# Test queue driver
# QUEUE_CONNECTION=sync

# Test mail driver
# MAIL_MAILER=array

# ----------------------------------------------------------------------------
# Production Environment Recommendations
# ----------------------------------------------------------------------------
# For production, ensure the following settings:
#
# APP_ENV=production
# APP_DEBUG=false
# APP_KEY=base64:...(must be set)
# APP_URL=https://example.com
# ASSET_URL=https://example.com
#
# Use strong passwords and secure database configuration
# Use Redis or Memcached for cache and session drivers
# Use HTTPS (SESSION_SECURE_COOKIE=true)
# Set appropriate log level (LOG_LEVEL=info or warning)
# Consider SESSION_SAME_SITE=lax (or none if cross-site is required)

# ============================================================================
# End of File
# ============================================================================
